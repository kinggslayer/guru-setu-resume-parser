# Copy this to .env and fill in your own values.
# .env is in .gitignore and must never be committed.

OPENAI_API_KEY=sk-...

# The service account JSON downloaded from Google Cloud.
GOOGLE_SERVICE_ACCOUNT_FILE=guru-setu-parser-010569bac098.json

# Optional: set these and `python parse_folder.py` needs no arguments.
DRIVE_FOLDER_LINK=https://drive.google.com/drive/folders/...
MASTER_FILE_LINK=https://docs.google.com/spreadsheets/d/.../edit

# Parallel OpenAI calls. 2 is right for a small machine.
OPENAI_WORKERS=2
