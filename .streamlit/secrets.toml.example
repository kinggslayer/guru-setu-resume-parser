# Streamlit Community Cloud secrets — TEMPLATE
#
# Do NOT fill this in and commit it. This file exists to show the shape.
# The real values go in the Community Cloud dashboard:
#     your app -> Settings -> Secrets -> paste -> Save
#
# Nothing here ever needs to be in the repo, which is why the app reads
# st.secrets first and falls back to .env only for local development.

OPENAI_API_KEY = "sk-..."

# 2 is right for the free tier. Higher just queues up against the 1 GB
# memory ceiling and gets the app killed mid-run.
OPENAI_WORKERS = 2


# The Google service-account key, field by field. Open the JSON file you
# downloaded from Google Cloud and copy each value across.
#
# Only Drive access is needed — the app reads the resume folder and writes
# nothing back to Google. No spreadsheet, no Sheets API.
#
# private_key is the one that trips people up: it contains real newlines.
# Use TOML's triple-quoted string exactly as shown and paste the key with
# its \n sequences intact — do not reformat it onto multiple lines.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n"""
client_email = "something@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"


# ---------------------------------------------------------------------------
#  OPTIONAL — lets the app's "Move duplicates to trash" button work.
#
#  Drive only allows a file's OWNER to delete it, and the service account
#  above is a different identity from your Gmail. These values let the app
#  perform deletions as you instead.
#
#  Generate them by running, on your own computer:
#      python cleanup_duplicates.py --setup
#
#  Leave them out and everything else still works — you just delete
#  duplicates in Drive by hand.
# ---------------------------------------------------------------------------

# GOOGLE_OAUTH_CLIENT_ID = "....apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET = "GOCSPX-..."

# One block per Gmail. Only a file's OWNER can trash it, so deleting
# duplicates that live in a second account needs that account's own token.
# The app matches each file's owner to the right block automatically.
#
#   [[google_accounts]]
#   email = "spd123451@gmail.com"
#   refresh_token = "1//0g..."
#
#   [[google_accounts]]
#   email = "second@gmail.com"
#   refresh_token = "1//0g..."
